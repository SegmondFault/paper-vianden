#!/bin/sh
# Joining never starts a session; the owner keeps its lifecycle.
set -eu
if [ "$#" -gt 1 ]; then echo 'Usage: join-range [--red|--control]' >&2; exit 2; fi
case "${1-}" in
  "") exec sudo /usr/local/bin/paper-vianden join ;;
  --red) exec sudo /usr/local/bin/paper-vianden join --role red ;;
  --control) exec sudo /usr/local/bin/paper-vianden join --role control ;;
  *) echo 'Usage: join-range [--red|--control]' >&2; exit 2 ;;
esac
