#!/bin/sh
# Generic account entry point. No host names, credentials or automatic startup.
set -eu
role=blue
check=
speed=1
seed=20260112
usage() { echo 'Usage: start-range [--red|--white|--check] [--clock-speed 1..3600] [--seed 0..4294967295]' >&2; exit 2; }
while [ "$#" -gt 0 ]; do
  case "$1" in
    --red) role=red; shift ;;
    --white) role=white; shift ;;
    --check) check=--check; shift ;;
    --clock-speed) [ "$#" -ge 2 ] || usage; speed=$2; shift 2 ;;
    --seed) [ "$#" -ge 2 ] || usage; seed=$2; shift 2 ;;
    *) usage ;;
  esac
done
# Python validates the bounded numeric speed before starting any session.
if [ -n "$check" ]; then
  exec sudo /usr/local/bin/paper-vianden run --clock-speed "$speed" --seed "$seed" --role "$role" --check
fi
exec sudo /usr/local/bin/paper-vianden run --clock-speed "$speed" --seed "$seed" --role "$role"
