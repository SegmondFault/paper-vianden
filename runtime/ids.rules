# Generic lab rules, deliberately small. These are observations, not answer keys.
# The scan rule excludes the management sensor's routine multi-host SSH polls.
alert http any any -> any any (msg:"LAB HTTP path traversal attempt"; flow:established,to_server; http.uri.raw; content:"../"; classtype:web-application-attack; sid:9000001; rev:1;)
alert http any any -> any any (msg:"LAB SQL union in HTTP request"; flow:established,to_server; http.uri; content:"union"; nocase; content:"select"; nocase; distance:0; within:120; classtype:web-application-attack; sid:9000002; rev:1;)
alert tcp !172.28.10.0/24 any -> any any (msg:"LAB TCP connection scan"; flags:S; flow:stateless; detection_filter:track by_src,count 25,seconds 10; classtype:network-scan; sid:9000003; rev:1;)
alert dns any any -> any any (msg:"LAB unusually long DNS label"; dns.query; pcre:"/(?:^|\.)[a-zA-Z0-9_-]{45,63}\./"; classtype:bad-unknown; sid:9000004; rev:1;)
