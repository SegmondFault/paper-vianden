# Deliberately allow directory enumeration in this disposable training service.
dn: olcDatabase={1}mdb,cn=config
changetype: modify
replace: olcAccess
olcAccess: {0}to attrs=userPassword,shadowLastChange by self write by anonymous auth by * none
olcAccess: {1}to * by dn.exact="cn=admin,dc=enum,dc=lab" write by * read
